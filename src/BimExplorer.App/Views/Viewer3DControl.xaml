<UserControl x:Class="BimExplorer.App.Views.Viewer3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30">
    <Grid>
        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay" Background="#2D2D30" Visibility="Collapsed" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Cargando modelo 3D..." Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Border>

        <!-- Placeholder when no file selected -->
        <Border x:Name="PlaceholderPanel" Background="#F0F0F0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                           Foreground="#BBB" HorizontalAlignment="Center"/>
                <TextBlock Text="Selecciona un archivo para ver la vista previa"
                           Foreground="#999" FontSize="13" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Thumbnail / icon for non-IFC files -->
        <Border x:Name="ThumbnailPanel" Background="#F0F0F0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="ThumbnailImage" MaxWidth="500" MaxHeight="500"
                       RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                <TextBlock x:Name="FileTypeLabel" FontSize="24" FontWeight="Bold"
                           Foreground="#888" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="FileNameLabel" FontSize="12" Foreground="#AAA"
                           HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                           MaxWidth="300" TextAlignment="Center"/>
                <TextBlock x:Name="ErrorLabel" FontSize="11" Foreground="#C44"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                           MaxWidth="350" TextAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 3D Viewport for IFC files -->
        <Border x:Name="ViewportPanel" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Viewport3D x:Name="Viewport3D" ClipToBounds="True">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" FieldOfView="45"
                                           UpDirection="0,0,1"/>
                    </Viewport3D.Camera>
                </Viewport3D>

                <!-- 3D View controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                            HorizontalAlignment="Right" Margin="8">
                    <Button Content="Reset" Click="ResetView_Click" Padding="8,4" Margin="2"
                            Background="#444" Foreground="White" BorderThickness="0"/>
                    <Button Content="Planta" Click="TopView_Click" Padding="8,4" Margin="2"
                            Background="#444" Foreground="White" BorderThickness="0"/>
                    <Button Content="Frontal" Click="FrontView_Click" Padding="8,4" Margin="2"
                            Background="#444" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
