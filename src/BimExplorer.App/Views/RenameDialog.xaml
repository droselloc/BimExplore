<Window x:Class="BimExplorer.App.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar nombre" Height="160" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D2D30" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Grid.Row="0" Text="Nuevo nombre:" Foreground="#CCC"
                   FontSize="12" Margin="0,0,0,8"/>

        <TextBox x:Name="NameTextBox" Grid.Row="1" FontSize="13" Padding="8,6"
                 Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                 BorderThickness="1" CaretBrush="White"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="80" Padding="0,6" Margin="0,0,8,0"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0"
                    Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="Aceptar" Width="80" Padding="0,6"
                    Background="#0E639C" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="Accept_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
