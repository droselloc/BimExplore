<Window x:Class="BimExplorer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BimExplorer.App.Converters"
        Title="BIM Explore" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="pack://application:,,,/Resources/app.ico"
        ToolTipService.InitialShowDelay="600"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="200">

    <Window.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Gallery item style -->
        <Style x:Key="GalleryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#264F78"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button style (preserves Background when disabled) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag chip style -->
        <Style x:Key="TagChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable field style -->
        <Style x:Key="EditableFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- Icon button style (used for gear icon) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E639C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab item dark style -->
        <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE713;" Style="{StaticResource IconButtonStyle}"
                        Margin="10,0,0,0" Click="OpenSettings_Click" ToolTip="Configuracion"/>
                <Button DockPanel.Dock="Right" Content="Indexar Carpeta" Command="{Binding IndexDirectoryCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="18,10" Margin="10,0,0,0" Background="#0E639C"
                        ToolTip="Seleccionar una carpeta y escanearla en busca de archivos BIM. Extrae metadatos y genera miniaturas. La carpeta queda guardada para futuras reindexaciones"/>
                <Button DockPanel.Dock="Right" Content="Limpiar Versiones" Command="{Binding CleanRevitVersionsCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="14,10" Margin="10,0,0,0" Background="#C24B3A"
                        ToolTip="Buscar y eliminar copias de version de Revit (*.0001.rvt, etc.)"/>
                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="10,10" Margin="10,0,0,0" Background="#2EA043"
                        FontSize="14" ToolTip="Actualizar galeria (regenerar previews)"/>
                <Button DockPanel.Dock="Right" Content="Limpiar" Command="{Binding ClearCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="14,10" Margin="10,0,0,0" Background="#3E3E42"
                        Foreground="#CCC" FontWeight="Normal"
                        ToolTip="Vaciar el texto de busqueda y mostrar todos los archivos indexados"/>
                <CheckBox DockPanel.Dock="Right" Content="FBX"
                          IsChecked="{Binding ShowFbxFiles}" VerticalAlignment="Center"
                          Foreground="#CCC" Margin="10,0,0,0" FontSize="12"
                          ToolTip="Mostrar/ocultar archivos FBX en la galeria"/>
                <CheckBox DockPanel.Dock="Right" Content="RVT"
                          IsChecked="{Binding ShowRvtFiles}" VerticalAlignment="Center"
                          Foreground="#CCC" Margin="10,0,0,0" FontSize="12"
                          ToolTip="Incluir proyectos Revit (.rvt) en indexacion y galeria. Son grandes, puede tardar mas"/>
                <Border Background="#3C3C3C" CornerRadius="4" Padding="4,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#888" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="6,8" VerticalContentAlignment="Center"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1" Height="4" Minimum="0"
                     Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                     Foreground="#007ACC" Background="#2D2D30" BorderThickness="0"
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Main tabs -->
        <TabControl Grid.Row="2" Background="#1E1E1E" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}"/>
            </TabControl.Resources>

            <!-- GALLERY TAB -->
            <TabItem Header="Galeria">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- CENTER: Image Gallery -->
                    <ListBox x:Name="GalleryListBox" Grid.Column="0"
                             ItemsSource="{Binding BimFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             Background="#1E1E1E" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource GalleryItemStyle}"
                             Padding="8"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="Gallery_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="150" Height="170">
                                    <Grid.ContextMenu>
                                        <ContextMenu Background="#2D2D30" BorderBrush="#555" Foreground="White">
                                            <MenuItem Header="Abrir"
                                                      Command="{Binding DataContext.OpenFileCommand, Source={x:Reference GalleryListBox}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#CCC"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Abrir ubicacion" Click="ContextOpenFolder_Click" Tag="{Binding FilePath}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#CCC"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#555"/>
                                            <MenuItem Header="Cambiar nombre"
                                                      Command="{Binding DataContext.RenameFileCommand, Source={x:Reference GalleryListBox}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#CCC"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#555"/>
                                            <MenuItem Header="Eliminar del indice"
                                                      Command="{Binding DataContext.DeleteFileFromIndexCommand, Source={x:Reference GalleryListBox}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#CCC"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Eliminar del disco"
                                                      Command="{Binding DataContext.DeleteFileFromDiskCommand, Source={x:Reference GalleryListBox}}"
                                                      CommandParameter="{Binding}" Foreground="#E06060">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E06060"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ToolTip>
                                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0"
                                                 HasDropShadow="True">
                                            <Border Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="1"
                                                    CornerRadius="6" SnapsToDevicePixels="True">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="4" Opacity="0.5" BlurRadius="10" Color="Black"/>
                                                </Border.Effect>
                                                <Grid Width="400">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="6,6,0,0"
                                                            MinHeight="280">
                                                        <Grid>
                                                            <Image Source="{Binding PreviewThumbnail}" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="10"
                                                                   Visibility="{Binding PreviewThumbnail, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                            <TextBlock Text="{Binding Extension}" FontSize="36" FontWeight="Bold"
                                                                       Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PreviewThumbnail}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1" Background="#2D2D30" Padding="12,8"
                                                            CornerRadius="0,0,6,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12"
                                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                            <TextBlock Foreground="#888" FontSize="10">
                                                                <Run Text="{Binding Extension, Mode=OneWay}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ProjectName}" Foreground="#007ACC" FontSize="10"
                                                                       Margin="0,2,0,0"
                                                                       Visibility="{Binding ProjectName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#252526" CornerRadius="4,4,0,0" Margin="4,4,4,0">
                                        <Grid>
                                            <Image Source="{Binding GalleryThumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="6"
                                                   Visibility="{Binding GalleryThumbnail, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GalleryThumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Extension}" FontSize="18" FontWeight="Bold"
                                                           Foreground="#555" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Open folder icon -->
                                            <Button Click="OpenFolder_Click" Tag="{Binding FilePath}"
                                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Margin="0,2,2,0" Cursor="Hand" ToolTip="Abrir ubicacion"
                                                    Width="22" Height="22" Padding="0" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#88252526" CornerRadius="3"
                                                                Width="22" Height="22">
                                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="12" Foreground="#AAA"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#0E639C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="6,4,6,5">
                                        <TextBlock Text="{Binding FileName}" Foreground="#DDD" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                        <TextBlock Foreground="#888" FontSize="9" Margin="0,1,0,0">
                                            <Run Text="{Binding Extension, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Width="4" Background="#3F3F46"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                    <!-- RIGHT: Detail / Properties -->
                    <Border Grid.Column="2" Background="#252526">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,16,16">
                                <!-- Preview -->
                                <Border Background="#1E1E1E" CornerRadius="6" Height="200" Margin="0,0,0,10">
                                    <Grid>
                                        <Image x:Name="DetailPreviewImage" Stretch="Uniform" Margin="8"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="DetailExtLabel" FontSize="32" FontWeight="Bold"
                                                   Foreground="#444" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Button Content="Abrir archivo" Command="{Binding OpenFileCommand}"
                                        Padding="0,8" Margin="0,0,0,10"
                                        Background="#0E639C" Foreground="White" BorderThickness="0"
                                        FontSize="12" Cursor="Hand" HorizontalAlignment="Stretch"
                                        ToolTip="Abrir el archivo seleccionado con su aplicacion por defecto (Revit, AutoCAD, etc.)"/>

                                <!-- Tags -->
                                <TextBlock Text="TAGS" FontWeight="SemiBold" Foreground="#666" FontSize="10"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedFileTags}" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TagChipStyle}"
                                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Clic para eliminar">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" x" FontSize="10" Foreground="#AAC"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddTagCommand}"
                                            Width="30" Background="#3E3E42" Foreground="White"
                                            BorderThickness="0" FontSize="14" Cursor="Hand" Margin="4,0,0,0"
                                            ToolTip="Anadir el tag escrito al archivo (tambien sirve la tecla Enter)"/>
                                    <Border Background="#3C3C3C" CornerRadius="3" Padding="2,0">
                                        <TextBox Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="6,5" Background="Transparent"
                                                 Foreground="White" BorderThickness="0" CaretBrush="White">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Border>
                                </DockPanel>

                                <Border Height="1" Background="#3F3F46" Margin="0,0,0,12"/>

                                <!-- Editable Properties -->
                                <TextBlock Text="PROPIEDADES" FontWeight="SemiBold" Foreground="#666"
                                           FontSize="10" Margin="0,0,0,10"/>

                                <TextBlock Text="Nombre de archivo" Foreground="#888" FontSize="11"/>
                                <TextBox Text="{Binding EditFileName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableFieldStyle}"/>

                                <TextBlock Text="Proyecto" Foreground="#888" FontSize="11"/>
                                <TextBox Text="{Binding EditProjectName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableFieldStyle}"/>

                                <TextBlock Text="Disciplina" Foreground="#888" FontSize="11"/>
                                <TextBox Text="{Binding EditDiscipline, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableFieldStyle}"/>

                                <TextBlock Text="Autor" Foreground="#888" FontSize="11"/>
                                <TextBox Text="{Binding EditAuthorName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableFieldStyle}"/>

                                <Button Content="Guardar cambios" Command="{Binding SavePropertiesCommand}"
                                        Padding="0,8" Margin="0,4,0,12"
                                        Background="#2EA043" Foreground="White" BorderThickness="0"
                                        FontSize="12" Cursor="Hand" HorizontalAlignment="Stretch"
                                        ToolTip="Guardar en la base de datos los cambios de proyecto, disciplina, autor y nombre. Si se renombra el archivo, tambien se renombra en disco"/>

                                <Border Height="1" Background="#3F3F46" Margin="0,0,0,12"/>

                                <TextBlock Text="INFORMACION" FontWeight="SemiBold" Foreground="#666"
                                           FontSize="10" Margin="0,0,0,10"/>

                                <TextBlock Text="Ruta" Foreground="#888" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedFile.FilePath, FallbackValue='-'}" Foreground="#999"
                                           Margin="0,2,0,8" TextWrapping="Wrap" FontSize="10"/>

                                <TextBlock Text="Tamano" Foreground="#888" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedFile.FileSizeBytes, Converter={StaticResource FileSizeConverter}, FallbackValue='-'}"
                                           Foreground="#CCC" Margin="0,2,0,8"/>

                                <TextBlock Text="Creacion" Foreground="#888" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedFile.CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', FallbackValue='-'}"
                                           Foreground="#CCC" Margin="0,2,0,8"/>

                                <TextBlock Text="Modificacion" Foreground="#888" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedFile.LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', FallbackValue='-'}"
                                           Foreground="#CCC" Margin="0,2,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SCRIPTS TAB -->
            <TabItem Header="Scripts">
                <Grid DataContext="{Binding Scripts}" Background="#1E1E1E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Script list -->
                    <Border Grid.Column="0" Background="#252526">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10,10,10,6" Background="#2D2D30">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="+ Nuevo"
                                            Command="{Binding NewScriptCommand}"
                                            Background="#0E639C" Foreground="White" BorderThickness="0"
                                            Padding="10,6" FontSize="11" Cursor="Hand"
                                            ToolTip="Crear un nuevo script en blanco (sin guardar todavia)"/>
                                    <TextBlock Text="SCRIPTS" Foreground="#888" FontWeight="SemiBold"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding Scripts}"
                                     SelectedItem="{Binding SelectedScript}"
                                     Background="Transparent" BorderThickness="0" Padding="4">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="10,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#0E639C"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Target}" Foreground="#AAC" FontSize="10"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" Background="#3F3F46"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                    <!-- Script editor -->
                    <Grid Grid.Column="2" Margin="16">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScriptSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Eliminar"
                                    Command="{Binding DeleteScriptCommand}"
                                    Background="#C24B3A" Foreground="White" BorderThickness="0"
                                    Padding="12,6" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                    ToolTip="Eliminar definitivamente el script seleccionado"/>
                            <Button DockPanel.Dock="Right" Content="Guardar"
                                    Command="{Binding SaveScriptCommand}"
                                    Background="#2EA043" Foreground="White" BorderThickness="0"
                                    Padding="12,6" FontSize="11" Cursor="Hand"
                                    ToolTip="Guardar los cambios del script en la base de datos"/>
                            <TextBlock Text="EDITAR SCRIPT" Foreground="#666" FontWeight="SemiBold"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Nombre" Foreground="#888" FontSize="11"/>
                        <TextBox Grid.Row="2"
                                 Text="{Binding SelectedScript.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableFieldStyle}"/>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Destino" Foreground="#888" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding AvailableTargets}"
                                          SelectedItem="{Binding SelectedScript.Target}"
                                          Margin="0,2,0,8" FontSize="12" Padding="6,4"
                                          Background="#3C3C3C" Foreground="White" BorderThickness="0"
                                          IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Descripcion" Foreground="#888" FontSize="11"/>
                                <TextBox Text="{Binding SelectedScript.Description, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource EditableFieldStyle}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Grid.Row="4" Margin="0,4,0,4">
                            <Button DockPanel.Dock="Right" Content="Copiar todo"
                                    Command="{Binding CopyCodeCommand}"
                                    Background="#0E639C" Foreground="White" BorderThickness="0"
                                    Padding="10,6" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                    ToolTip="Copiar todo el codigo al portapapeles"/>
                            <Button DockPanel.Dock="Right" Content="Pegar"
                                    Command="{Binding PasteCodeCommand}"
                                    Background="#3E3E42" Foreground="White" BorderThickness="0"
                                    Padding="10,6" FontSize="11" Cursor="Hand"
                                    ToolTip="Pegar desde el portapapeles"/>
                            <TextBlock Text="Codigo" Foreground="#888" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="5" Background="#1E1E1E" BorderBrush="#3F3F46"
                                BorderThickness="1" CornerRadius="3">
                            <TextBox Text="{Binding SelectedScript.Code, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Background="Transparent" Foreground="#DDD" BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Padding="8" CaretBrush="White"/>
                        </Border>

                        <TextBlock Grid.Row="6" Text="{Binding StatusText}" Foreground="#888"
                                   FontSize="11" Margin="2,8,0,0"/>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="Selecciona un script o crea uno nuevo"
                               Foreground="#666" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScriptSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="12,6" Background="#007ACC">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>
