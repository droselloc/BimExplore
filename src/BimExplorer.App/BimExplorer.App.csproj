<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>BimExplore</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>David</Authors>
    <Product>BIM Explore</Product>
  </PropertyGroup>

  <!-- Defaults aplicados al hacer `dotnet publish`.
       NO usamos EnableCompressionInSingleFile porque la compresion
       (autoextraible nativo) dispara muchisimos falsos positivos en
       antivirus y SmartScreen. A cambio el .exe pesa mas. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
    <PackageReference Include="OpenMcdf" Version="3.1.1" />
    <PackageReference Include="Xbim.Essentials" Version="6.0.*" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BimExplorer.Data\BimExplorer.Data.csproj" />
  </ItemGroup>

</Project>
